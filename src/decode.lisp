(defparameter +op+
  (loop for byte below 256
        for name = (aref *op-name* byte)
        unless (eq name :unknown)
          collect (cons name byte))
  "Alist of opcode keywords → byte values.")

(defun op-name-key (name)
  "Normalize an opcode designator to a keyword."
  (cond
    ((keywordp name) name)
    ((symbolp name) (intern (symbol-name name) :keyword))
    ((stringp name) (intern (string-upcase name) :keyword))
    (t (error "Bad opcode designator: ~S" name))))

(defun op-byte (name)
  (let ((key (op-name-key name)))
    (or (gethash key *op-byte*)
        (error "Unknown opcode name: ~S" name))))

(defun op-name (byte)
  (aref *op-name* (u8 byte)))

(defstruct (instruction (:conc-name inst-))
  (op 0 :type (unsigned-byte 8))
  (x  0 :type (unsigned-byte 8))
  (y  0 :type (unsigned-byte 8))
  (z  0 :type (unsigned-byte 8))
  (raw 0 :type (unsigned-byte 32)))

(defun decode (word)
  "Decode a 32-bit big-endian instruction word into an INSTRUCTION."
  (let ((w (u32 word)))
    (make-instruction
     :op  (ldb (byte 8 24) w)
     :x   (ldb (byte 8 16) w)
     :y   (ldb (byte 8 8) w)
     :z   (ldb (byte 8 0) w)
     :raw w)))

(defun encode (op x y z)
  "Encode OP X Y Z into a 32-bit instruction word."
  (logior (ash (u8 (if (symbolp op) (op-byte op) op)) 24)
          (ash (u8 x) 16)
          (ash (u8 y) 8)
          (u8 z)))

(defun inst-yz (inst)
  (logior (ash (inst-y inst) 8) (inst-z inst)))

(defun inst-xyz (inst)
  (logior (ash (inst-x inst) 16)
          (ash (inst-y inst) 8)
          (inst-z inst)))

(defun fetch (vm)
  "Fetch the tetrabyte at PC, ignoring the low two bits. Does not advance PC."
  (mem-ref-u32 vm (logand (vm-pc vm) (lognot 3)) :internal t))

(defun relative-disp (field bits backward)
  (if backward (- field (ash 1 bits)) field))

(defun disassemble-at (vm &optional (addr (vm-pc vm)))
  "Return a human-readable string for the instruction at ADDR."
  (let* ((addr (logand (u64 addr) (lognot 3)))
         (word (mem-ref-u32 vm addr :internal t))
         (inst (decode word))
         (op (inst-op inst))
         (name (op-name op))
         (x (inst-x inst))
         (y (inst-y inst))
         (z (inst-z inst))
         (yz (inst-yz inst))
         (xyz (inst-xyz inst)))
    (cond
      ((eq name :unknown)
       (format nil "??? #~8,'0X" word))
      ((<= #xE0 op #xEF)
       (format nil "~A $~D,#~4,'0X" name x yz))
      ((or (= op #xF0) (= op #xF1))
       (format nil "~A #x~X"
               name
               (u64 (+ addr (* 4 (relative-disp xyz 24 (= op #xF1)))))))
      ((or (= op #xF2) (= op #xF3) (= op #xF4) (= op #xF5)
           (<= #x40 op #x5F))
       (format nil "~A $~D,#x~X"
               name x
               (u64 (+ addr (* 4 (relative-disp yz 16 (oddp op)))))))
      ((= op #xF6)
       (format nil "PUT ~A,$~D" (special-name x) z))
      ((= op #xF7)
       (format nil "PUTI ~A,~D" (special-name x) z))
      ((= op #xF8)
       (format nil "POP ~D,~D" x yz))
      ((= op #xFE)
       (format nil "GET $~D,~A" x (special-name z)))
      ((= op #x00)
       (format nil "TRAP ~D,~D,~D" x y z))
      ((= op #xFF)
       (format nil "TRIP ~D,~D,~D" x y z))
      ((member op '(#xF9 #xFA #xFB #xFC #xFD))
       (format nil "~A ~D" name xyz))
      ((oddp op)
       (format nil "~A $~D,$~D,~D" name x y z))
      (t
       (format nil "~A $~D,$~D,$~D" name x y z)))))
