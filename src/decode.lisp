(in-package #:cl-mmix)

;;; Full MMIX opcode map (Knuth, mmop.html). Execution of floating-point
;;; and of SAVE/UNSAVE is deferred; the names are still known to the decoder.

(defvar *op-byte* (make-hash-table :test 'eq))
(defvar *op-name* (make-array 256 :initial-element :unknown))

(defun register-op (byte name)
  (setf (aref *op-name* byte) name)
  (setf (gethash name *op-byte*) byte)
  name)

(defun register-pair (byte name)
  "Register BYTE as NAME and BYTE+1 as the immediate form NAMEI."
  (register-op byte name)
  (register-op (1+ byte)
               (intern (concatenate 'string (symbol-name name) "I") :keyword)))

(defun register-branch (byte name)
  "Register BYTE as NAME and BYTE+1 as the backward form NAMEB."
  (register-op byte name)
  (register-op (1+ byte)
               (intern (concatenate 'string (symbol-name name) "B") :keyword)))

